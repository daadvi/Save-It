rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    match /users/{uid}/records/{record} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['key', 'data', 'updatedAt'])
        && request.resource.data.key is string
        && request.resource.data.key.size() <= 1000
        && (request.resource.data.data == null
          || (request.resource.data.data is string && request.resource.data.data.size() <= 900000))
        && request.resource.data.updatedAt == request.time
        && (resource == null || request.resource.data.key == resource.data.key);
    }
  }
}
